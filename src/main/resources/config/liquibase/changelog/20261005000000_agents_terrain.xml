<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Agents de terrain : uniquement des ajouts, rejouables sans risque sur la base de production. -->

    <changeSet id="20261005000000-1" author="sansfile">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM jhi_authority WHERE name = 'ROLE_AGENT'</sqlCheck>
        </preConditions>
        <comment>Rôle des agents de terrain</comment>
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_AGENT"/>
        </insert>
    </changeSet>

    <changeSet id="20261005000000-2" author="sansfile">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="jhi_user" columnName="must_change_password"/>
            </not>
        </preConditions>
        <comment>Mot de passe provisoire à remplacer à la prochaine connexion (agents de terrain)</comment>
        <addColumn tableName="jhi_user">
            <column name="must_change_password" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20261005000000-3" author="sansfile">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="salon" columnName="created_by_agent_id"/>
            </not>
        </preConditions>
        <comment>Agent de terrain qui a inscrit le salon (vide : créé par l'administration)</comment>
        <addColumn tableName="salon">
            <column name="created_by_agent_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="salon"
            baseColumnNames="created_by_agent_id"
            constraintName="fk_salon__created_by_agent_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
        <createIndex tableName="salon" indexName="idx_salon__created_by_agent_id">
            <column name="created_by_agent_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261005000000-4" author="sansfile">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="agent_activity"/>
            </not>
        </preConditions>
        <comment>Journal des actions des agents de terrain (et des actions de l'admin sur leurs comptes)</comment>
        <createTable tableName="agent_activity">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="agent_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="salon_id" type="bigint"/>
            <column name="actor" type="varchar(254)"/>
            <column name="ip_address" type="varchar(64)"/>
            <column name="user_agent" type="varchar(255)"/>
            <column name="created_date" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="agent_activity"
            baseColumnNames="agent_id"
            constraintName="fk_agent_activity__agent_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="agent_activity"
            baseColumnNames="salon_id"
            constraintName="fk_agent_activity__salon_id"
            referencedTableName="salon"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
        <createIndex tableName="agent_activity" indexName="idx_agent_activity__agent_created">
            <column name="agent_id"/>
            <column name="created_date"/>
        </createIndex>
        <createIndex tableName="agent_activity" indexName="idx_agent_activity__created">
            <column name="created_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
