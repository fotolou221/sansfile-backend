<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260909000200-1" author="codex">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="ticket" columnName="owner_phone"/>
            </not>
        </preConditions>
        <addColumn tableName="ticket">
            <column name="owner_phone" type="varchar(30)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260909000200-2" author="codex" dbms="postgresql">
        <validCheckSum>ANY</validCheckSum>
        <sql>
            <!-- Nettoyer les doublons historiques de numéros relatifs par utilisateur -->
            DELETE FROM relative r1
            USING relative r2
            WHERE r1.id &lt; r2.id
              AND r1.user_id = r2.user_id
              AND r1.phone = r2.phone
              AND r1.phone IS NOT NULL
              AND btrim(r1.phone) &lt;&gt; '';

            CREATE UNIQUE INDEX IF NOT EXISTS ux_relative_user_phone
                ON relative (user_id, phone)
                WHERE phone IS NOT NULL AND btrim(phone) &lt;&gt; '';
        </sql>
    </changeSet>

    <changeSet id="20260909000200-3" author="codex">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_ticket_owner_phone" tableName="ticket"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_ticket_owner_phone" tableName="ticket">
            <column name="owner_phone"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
